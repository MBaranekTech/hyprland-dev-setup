{
  "layer": "top",
  "position": "top",
  "height": 30,
  "spacing": 8,
  "modules-left": ["hyprland/workspaces", "hyprland/submap"],
  "modules-center": ["clock", "custom/year"],
  "modules-right": ["hyprland/language", "custom/night-light", "cpu", "memory", "bluetooth", "network", "pulseaudio", "battery", "custom/notifications", "tray", "custom/power"],
  "hyprland/workspaces": {
    "format": "{name}",
    "on-click": "activate",
    "persistent-workspaces": {"*": [1, 2, 3, 4, 5]}
  },
  "hyprland/language": {
    "format": "{}",
    "format-cs": "<b>CZ</b> / ENG",
    "format-en": "CZ / <b>ENG</b>",
    "on-click": "hyprctl switchxkblayout all next"
  },
  "clock": {
    "format": "{:%a %d.%m.  %H:%M}",
    "tooltip-format": "<tt>{calendar}</tt>\nKliknutím otevřeš kalendář",
    "calendar": {"iso8601": true},
    "on-click": "pkill -u $(id -u) -x waycal || @HOME@/.local/bin/waycal --week-start monday"
  },
  "custom/year": {
    "exec": "/usr/bin/python3 @HOME@/.config/hypr/scripts/year-progress.py",
    "return-type": "json",
    "interval": 60,
    "on-click": "pkill -u $(id -u) -x waycal || @HOME@/.local/bin/waycal --week-start monday"
  },
  "custom/night-light": {
    "exec": "/usr/bin/python3 @HOME@/.config/hypr/scripts/night-light.py",
    "return-type": "json",
    "interval": 10,
    "on-click": "/usr/bin/python3 @HOME@/.config/hypr/scripts/night-light.py toggle",
    "on-click-right": "/usr/bin/python3 @HOME@/.config/hypr/scripts/night-light.py menu",
    "on-click-middle": "/usr/bin/python3 @HOME@/.config/hypr/scripts/night-light.py auto"
  },
  "cpu": {"format": "CPU {usage}%", "interval": 5},
  "memory": {"format": "RAM {used:0.1f}G", "interval": 5},
  "bluetooth": {
    "format": "",
    "format-off": "",
    "format-disabled": "",
    "format-connected": " {num_connections}",
    "format-no-controller": " ?",
    "tooltip-format": "Bluetooth {status}\nClick: manage devices\nRight-click: turn on/off",
    "tooltip-format-connected": "Bluetooth: {num_connections} connected\n{device_enumerate}\nClick: manage devices\nRight-click: turn on/off",
    "tooltip-format-enumerate-connected": "{device_alias}",
    "tooltip-format-enumerate-connected-battery": "{device_alias}: {device_battery_percentage}%",
    "on-click": "blueman-manager",
    "on-click-right": "sh @HOME@/.config/hypr/scripts/bluetooth-toggle.sh"
  },
  "network": {
    "format-wifi": "Wi-Fi {signalStrength}%",
    "format-ethernet": "LAN",
    "format-disconnected": "Offline",
    "tooltip-format": "{ifname}: {ipaddr}",
    "on-click": "nm-connection-editor"
  },
  "pulseaudio": {"format": "VOL {volume}%", "format-muted": "Muted", "on-click": "pavucontrol"},
  "battery": {"format": "BAT {capacity}%", "format-charging": "AC {capacity}%", "states": {"warning": 25, "critical": 10}},
  "custom/notifications": {
    "exec": "swaync-client -swb",
    "return-type": "json",
    "format": "{icon}",
    "format-icons": {
      "notification": "",
      "none": "",
      "dnd-notification": "",
      "dnd-none": "",
      "inhibited-notification": "",
      "inhibited-none": "",
      "dnd-inhibited-notification": "",
      "dnd-inhibited-none": ""
    },
    "tooltip": true,
    "on-click": "swaync-client -t",
    "on-click-right": "swaync-client -d",
    "exec-on-event": false
  },
  "tray": {"spacing": 8},
  "custom/power": {"format": "Menu", "on-click": "sh @HOME@/.config/hypr/scripts/power-menu.sh"}
}
