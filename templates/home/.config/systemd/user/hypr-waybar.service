[Unit]
Description=Hyprland top bar
PartOf=graphical-session.target
ConditionEnvironment=XDG_CURRENT_DESKTOP=Hyprland
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/bin/waybar -c %h/.config/hypr/waybar.json -s %h/.config/hypr/waybar.css
ExecReload=/bin/kill -USR2 $MAINPID
Restart=on-failure
RestartSec=2
